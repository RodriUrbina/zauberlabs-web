# Added automatically when you connect Upstash Redis from the Vercel Marketplace
# (KV_REST_API_*). UPSTASH_REDIS_REST_* also works. Required in production;
# in local development votes/suggestions are kept in memory without them.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Any long random string; used to hash visitor IPs for rate limiting.
VOTE_SALT=

# Password for the suggestions admin at /de/admin. Admin is disabled if unset.
ADMIN_PASSWORD=

# E46 configurator switch (BL-001). The configurator is not online yet: leave unset/0 and every
# E46 button on the site and the blog CTA show "coming soon" with no link. Set to 1 to go live.
NEXT_PUBLIC_E46_LIVE=0

# BL-039: secret for the internal-mode URL /api/internal-mode?k=<secret> that excludes the PO's own devices
# from Vercel Web Analytics. At least 24 random characters; unset = the switch is off (route answers 404).
ZL_INTERNAL_SECRET=
